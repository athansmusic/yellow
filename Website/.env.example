# ── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://theredactedunit.com

# ── Store: Printful (catalog + fulfilment) ───────────────────────────
# Printful → Settings → Stores → (your API store) → API → "Private token"
# Leave empty to run the store from src/data/products-fixture.json (demo only).
PRINTFUL_API_KEY=
# Set to false while testing so webhook orders land in Printful as drafts, not confirmed
PRINTFUL_ORDER_CONFIRM=true
# Optional: secret you set on the Printful webhook (package_shipped etc.)
PRINTFUL_WEBHOOK_SECRET=

# ── Store: Stripe (payment) ──────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or Dashboard → Developers → Webhooks in prod
STRIPE_WEBHOOK_SECRET=

# ── Optional: richer episode links (Spotify / Patreon per-episode) ───
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
PATREON_ACCESS_TOKEN=

# ── Optional: transactional email for shipping notifications ─────────
RESEND_API_KEY=
ORDER_EMAIL_FROM="[REDACTED] Store <store@theredactedunit.com>"

# ── Optional: revalidate catalog on demand (POST /api/revalidate?secret=) ─
REVALIDATE_SECRET=

# Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# Twitch app credentials (dev.twitch.tv/console/apps, any redirect URL). Used only to ask "is the channel live?"
# for the site-wide live dock. Leave empty and the dock falls back to the Thursday schedule window with a link instead of an embed.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Admin (/admin): Google sign-in restricted to the show's Workspace domain ──
# Google Cloud console → APIs & Services → Credentials → OAuth client (Web). Redirect URI: {site}/api/auth/callback/google
AUTH_SECRET=            # any long random string (openssl rand -base64 32)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAIL_DOMAIN=theredactedunit.com
ADMIN_EMAILS=           # optional extra addresses, comma separated
# Production content store for admin edits (Vercel → Storage → Blob; token is injected automatically on Vercel)
BLOB_READ_WRITE_TOKEN=

# ── Fan art (pushed by Streamv2/control when you approve pieces) ─────
# Any long random string; the same value goes in Streamv2 config.local.json under tumblr.website_token
FANART_TOKEN=

# Curtain POSTs to /api/revalidate with "Authorization: Bearer <REVALIDATE_SECRET>" when an episode publishes or a transcript is locked. CURTAIN_URL defaults to https://www.opencurtain.app
